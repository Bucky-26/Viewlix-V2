{
  "rules": {
    "app_config": {
      ".read": true,
      ".write": false
    },
    "mobile_app_config": {
      ".read": true,
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "fcmTokens": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "support_chats": {
      "$ticketId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    }
  }
}

